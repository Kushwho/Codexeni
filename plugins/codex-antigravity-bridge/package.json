{
  "name": "codex-antigravity-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP bridge that delegates coding tasks to the local Antigravity CLI.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --sourcemap",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test --test-concurrency=1 test/runtime.test.mjs",
    "test:fixture": "node --test fixtures/clamp/test/clamp.test.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.9",
    "typescript": "^5.8.3"
  }
}
